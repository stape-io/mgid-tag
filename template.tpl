      return Promise.create((resolve) => resolve({ statusCode: 500, body: '' }));
    });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
    callLater(() => {
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
setup: |-
  const JSON = require('JSON');
  const Promise = require('Promise');
  const callLater = require('callLater');
  const assign = (target, source) => {
      if (!source) return target;
      for (const key in source) {
        target[key] = source[key];
      }
      return target;
    };
  const createMockData = (overrides) => {
    return assign({
      clientId: 'client123', // Fixed: Matches parameter 'clientId'
      eventName: 'event_name',
      revenue: '1',
      cookieExpiration: 365,
      cookieDomain: 'auto',
      cookieSameSite: 'none',
      cookieHttpOnly: false,
    }, overrides);
  };

  const mockData = createMockData();
  mock('getRequestHeader', (header) => {
  if(header === 'referer') return 'http://referer.com';
  if(header === 'trace-id') return 'trace_id_123';
  });
  mock('getAllEventData', () => (
     {
    'page_location': 'https://example.com'
  }));
  mock('getEventData', () => undefined);
  mock('getCookieValues', () => []);
  mock('setCookie', () => {});
  mock('computeEffectiveTldPlusOne', () => 'example.com');
  mock('sendHttpRequest', (url, options, body) => {
    return Promise.create((resolve) => resolve({ statusCode: 200, body: '' }));
  });


