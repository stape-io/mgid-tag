    assertApi('setCookie').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Page View] Stores the click id cookie using the configured domain sameSite
    httpOnly and expiration'
  code: |-
    mockData.type = 'pageview';
    mockData.cookieDomain = 'example.com';
    mockData.cookieSameSite = 'strict';
    mockData.cookieHttpOnly = true;
    mockData.cookieExpiration = 7;
    mock('getAllEventData', () => ({
      page_location: 'https://example.com/?adclid=123'
    }));
    let capturedOptions;
    mock('setCookie', (name, value, options) => {
      capturedOptions = options;
    });
    runCode(mockData);
    callLater(() => {
      assertThat(capturedOptions.domain).isEqualTo('example.com');
      assertThat(capturedOptions.samesite).isEqualTo('strict');
      assertThat(capturedOptions.httpOnly).isTrue();
      assertThat(capturedOptions.secure).isTrue();
      assertThat(capturedOptions['max-age']).isEqualTo(60 * 60 * 24 * 7);
      assertApi('sendHttpRequest').wasNotCalled();
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
- name: '[Conversion] Sends conversion postback request with clientId, eventName,
    clickId, revenue'
  code: |-
